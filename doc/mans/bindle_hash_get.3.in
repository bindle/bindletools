.TH "BINDLE_URLDESC" "3" "@RELEASE_MONTH@" "@PACKAGE_NAME@" "Library Functions Manual"
.SH NAME
bindle_hash_get, bindle_hash_get_r, bindle_hash_sget, bindle_hash_sget_r - Bindle Binary Tools hash table query routines

.SH LIBRARY
Bindle Binaries Tools (libbindle, -lbindle)

.SH SYNOPSIS
.nf
\fB#include\fR \fB<bindle.h>\fR
.sp
.BI "int bindle_hash_get( bindle_hash_t * " bh ", const void * " key ,
.BI "                     size_t " key_len ", const void ** " valp ,
.BI "                     size_t * " val_lenp " );"
.sp
.BI "int bindle_hash_get_r( bindle_hash_t * " bh ", const void * " key ,
.BI "                       size_t " key_len ", void * " dst ", size_t " n ,
.BI "                       size_t * " val_lenp " );"
.sp
.BI "int bindle_hash_sget( bindle_hash_t * " bh ", const char * " key ,
.BI "                      const void ** " valp ", size_t * " val_lenp " );"
.sp
.BI "int bindle_hash_sget_r( bindle_hash_t * " bh ", const char * " key ,
.BI "                        void * " dst ", size_t " n ", size_t * " val_lenp " );"
.fi

.SH DESCRIPTION
The \fBbindle_hash_get\fR() queries the hash referenced by \fIbh\fR for the
binary key referenced by \fIkey\fR with a length of \fIkey_len\fR bytes.  If
\fIvalp\fR is not \fBNULL\fR, the memory address of the value will be set in
\fI*valp\fR. If \fIval_lenp\fR is not \fBNULL\fR, the length of the value will
be set to \fI*val_lenp\fR.
.sp
The \fBbindle_hash_get_r\fR() queries the hash referenced by \fIbh\fR for the
binary key referenced by \fIkey\fR with a length of \fIkey_len\fR bytes.  Up
to \fIn\fR bytes of the value will be copied to the memory referenced by
\fIdst\fR. If \fIval_lenp\fR is not \fBNULL\fR, the number of bytes copied
will be set to \fI*val_lenp\fR.
.sp
The \fBbindle_hash_sget\fR() queries the hash referenced by \fIbh\fR for the
string key referenced by \fIkey\fR.  If \fIvalp\fR is not \fBNULL\fR, the
memory address of the value will be set in \fI*valp\fR. If \fIval_lenp\fR is
not \fBNULL\fR, the length of the value will be set to \fI*val_lenp\fR.
.sp
The \fBbindle_hash_sget_r\fR() queries the hash referenced by \fIbh\fR for the
string key referenced by \fIkey\fR.  Up to \fIn\fR bytes of the value will be
copied to the memory referenced by \fIdst\fR. If \fIval_lenp\fR is not
\fBNULL\fR, the number of bytes copied will be set to \fI*val_lenp\fR.

.SH RETURN VALUES
The \fBbindle_hash_get\fR(), \fBbindle_hash_get_r\fR(),
\fBbindle_hash_sget\fR(), and \fBbindle_hash_sget\fR() functions return 0 if
successful. If an error was encountered, \fIerrno\fR will be set
and the functions will return -1.

.SH SEE ALSO
.BR bindletools (3),
.BR bindle_hash_initialize (3),
.BR bindle_hash_del (3),
.BR bindle_hash_keys (3),
.BR bindle_hash_set (3),
.BR bindle_hash_funcs (3)

