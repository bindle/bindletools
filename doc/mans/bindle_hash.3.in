.TH "BINDLE_URLDESC" "3" "@RELEASE_MONTH@" "@PACKAGE_NAME@" "Library Functions Manual"
.SH NAME
bindle_hash_initialize, bindle_hash_len, bindle_hash_opts, bindle_hash_free - Bindle Binary Tools hash table management routines

.SH LIBRARY
Bindle Binaries Tools (libbindle, -lbindle)

.SH SYNOPSIS
.nf
\fB#include\fR \fB<bindle.h>\fR
.sp
.BI "int bindle_hash_initialize( bindle_hash_t ** " bhp ", int " opts " );"
.sp
.BI "size_t bindle_hash_len( bindle_hash_t * " bh " );"
.sp
.BI "int bindle_hash_opts( bindle_hash_t * " bh " );"
.sp
.BI "void bindle_hash_free( bindle_hash_t * " bh " );"
.fi

.SH DESCRIPTION
The \fBbindle_hash_initialize\fR() function allocates and initializes a hash
table which allows arbitrary data to be used as keys and values.  The
length of keys must be greater than 0 and less then
(\fBBNDL_HASH_KEY_LIMIT\fR +1). The refererence to the initialized
\fBbindle_hash_t\fR reference will be stored to \fIbhp\fR. \fIopts\fR defines
the behavior of the hash table using bit flags. The following options are
supported:
.RS 6
.TP 15                         
.B BNDL_HASH_REPLACE
causes duplicate keys to replace the value of existing values. If not,
specified attempting to create a duplicate key will result in an error.
.TP 15
.B BNDL_HASH_CASE  
causes keys to be case insensitive if the hash table is also initialized with
\fBBNDL_HKEY_STRING\fR.
.RE
.PP
The following options specify the type of data used for the hash keys. Only
one of the following options may be specified.
.RS 6
.TP 15                         
.B BNDL_HKEY_BINARY
specifies that the hash keys are binary data and must be accessed using
methods supporting explicity key length and values.  This is the default
option.
.TP 15
.B BNDL_HKEY_STRING  
specifies that the hash keys are ASCII compatible strings and must be NULL
terminated. Attempting to specify a hash key with a binary value which is not
\fBNULL\fR terminated will result in an error.  If \fBBNDL_HASH_CASE\fR is
also specified, they has keys will be case insensitive.
.RE
.PP
The following options specify the type of data used for the hash values. Only
one of the following options may be specified.
.RS 6
.TP 15                         
.B BNDL_HVAL_BINARY
specifies that the hash keys are binary data.  This is the default option.
.TP 15
.B BNDL_HVAL_STRING  
specifies that the hash values are ASCII compatible strings and must be NULL
terminated. Attempting to specify a hash value with a \fBbindle_berval_t|fR
value which is not NULL terminated will result in an error.
.TP 15
.B BNDL_HVAL_INT  
specifies that the hash values are of type \fBint\fR. Attempting to specify a
hash value with a \fBbindle_berval_t\fR value which is not exactly
\fBsizeof\fR(\fIint\fR) will result in an error.
.TP 15
.B BNDL_HVAL_UNSIGNED  
specifies that the hash values are of type \fBunsigned\fR. Attempting to
specify a hash value with a \fBbindle_berval_t\fR value which is not exactly
\fBsizeof\fR(\fIunsigned\fR) will result in an error.
.TP 15
.B BNDL_HVAL_DOUBLE  
specifies that the hash values are of type \fBdouble\fR. Attempting to
specify a hash value with a \fBbindle_berval_t\fR value which is not exactly
\fBsizeof\fR(\fIdouble\fR) will result in an error.
.TP 15
.B BNDL_HVAL_PTR
specifies that the hash values are a complex data structure referenced as a
pointer.  The referenced memory address will be stored in the hash. The
function to free the complex data structure can be specified with
\fBbindle_hash_func_ptr_free\fR().
.RE
.PP
The \fBbindle_hash_free\fR() function frees the hash elements and hash
table referenced by \bIbh\fR.
.sp
The \fBbindle_hash_len\fR() function returns the number of elements contained
within the hash table referenced by \fIbh\fR.
.sp
The \fBbindle_hash_opts\fR() function returns the \fIopts\fR used to
initialize the hash table referenced by \fIbh\fR.

.SH RETURN VALUES
The \fBbindle_hash_initialize\fR() functions assign the allocated hash table
to the reference specified by \fIbhp\fR and returns 0 if successful. If an
error was encountered, \fIerrno\fR will be set, \fIbhp\fR will be unchanged,
and the function will return -1.
.sp
The \fBbindle_hash_len\fR() function returns the number of elements contained
within the hash table referenced by \fIbh\fR.
.sp
The \fBbindle_hash_opts\fR() function returns the \fIopts\fR used to
initialize the hash table referenced by \fIbh\fR.

.SH EXAMPLE
The example below adds elements to a hash, queries a hash, and deletes
elements from a hash.
.nf

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <bindle.h>

struct
{  const char *   name;
   const char *   party;
} test_data[] =
{  {  "George Washington",       "Unaffiliated" },
   {  "John Adams",              "Federalist" },
   {  "Thomas Jefferson",        "Democratic-Republican" },
   {  "James Madison",           "Democratic-Republican" },
   {  "James Monroe",            "Democratic-Republican" },
   {  "John Quincy Adams",       "Democratic-Republican / National Republican" },
   {  "Andrew Jackson",          "Democratic" },
   {  "Martin Van Buren",        "Democratic" },
   {  "William Henry Harrison",  "Whig" },
   {  "John Tyler",              "Whig" },
   {  "James K. Polk",           "Democratic" },
   {  "Zachary Taylor",          "Whig" },
   {  "Millard Fillmore",        "Whig" },
   {  "Franklin Pierce",         "Democratic" },
   {  "James Buchanan",          "Democratic" },
   {  "Abraham Lincoln",         "Republican / National Union" },
   {  NULL,                      NULL }
};

int
main( void )
{
   int                        opts;
   size_t                     pos;
   size_t                     namelen;
   size_t                     partylen;
   bindle_hash_t *            bh;
   const char *               name;
   const char *               party;
   const void *               val;
   size_t                     vallen;
   bindle_berval_t *          key;
   bindle_berval_t **         keys;

   opts = BNDL_HKEY_STRING | BNDL_HVAL_STRING;
   if (bindle_hash_initialize(&bh, opts) == -1)
   {  perror("bindle_hash_initialize()");
      return(1);
   };

   // populate hash
   for(pos = 0; ((test_data[pos].name)); pos++)
   {  name     = test_data[pos].name;
      namelen  = strlen(name)+1;
      party    = test_data[pos].party;
      partylen = strlen(party)+1;
      if (bindle_hash_set(bh, name, namelen, party, partylen))
      {  perror("bindle_hash_set()");
         bindle_hash_free(bh);
         return(1);
      };
   };

   // retrieve list of keys
   if (bindle_hash_keys(bh, &keys) == -1)
   {  perror("bindle_hash_keys()");
      bindle_hash_free(bh);
      return(1);
   };

   // retrieve value for each key
   for(pos = 0; ((keys[pos])); pos++)
   {  key = keys[pos];
      if (bindle_hash_get(bh, key->bv_val, key->bv_len, &val, &vallen) == -1)
      {  perror("bindle_hash_get()");
         bindle_bvarray_free(keys);
         bindle_hash_free(bh);
         return(1);
      };
      printf("%-25s (%s)\n", (char *)key->bv_val, (const char *)val);
   };

   // delete elements from hash
   for(pos = 0; ((keys[pos])); pos++)
   {  key = keys[pos];
      if (bindle_hash_del(bh, key->bv_val, key->bv_len) == -1)
      {  perror("bindle_hash_del()");
         bindle_bvarray_free(keys);
         bindle_hash_free(bh);
         return(1);
      };
   };

   // frees memory
   bindle_bvarray_free(keys);
   bindle_hash_free(bh);

   return(0);
}
.fi

.SH SEE ALSO
.BR bindletools (3),
.BR bindle_hash_del (3),
.BR bindle_hash_get (3),
.BR bindle_hash_keys (3),
.BR bindle_hash_set (3),
.BR bindle_hash_funcs (3),
.BR bindle_array (3),
.BR bindle_berval (3)

